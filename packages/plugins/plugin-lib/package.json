    "jszip": "^3.10.1",
    "lodash-es": "^4.17.21",
    "psl": "^1.15.0",
    "punycode.js": "^2.3.1"
  },
  "devDependencies": {
    "@types/chai": "^4.3.12",
    "@types/mocha": "^10.0.6",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "chai": "^5.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "esmock": "^2.7.5",
    "mocha": "^10.6.0",
    "node-forge": "^1.3.1",
    "prettier": "3.3.3",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.4.2"
  },
  "gitHead": "67f3daae625ba734e7e390dd84acc9e3bc1930bc"
