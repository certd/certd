    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "chai": "^5.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "esmock": "^2.7.5",
    "mocha": "^10.6.0",
    "prettier": "3.3.3",
    "tslib": "^2.8.1",
    "typescript": "^5.4.2"
  },
